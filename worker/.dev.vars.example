# Copiar a .dev.vars (ignorado por git) y rellenar. Nunca commitear valores reales.
# Solo el HASH (hex, 64 caracteres) del token. Generar token + hash con:
#   npm run gen:token -w worker
# El TOKEN va en la PWA/Scriptable/Atajos; aqui va solo el HASH.
APP_TOKEN_SHA256=
# OAuth Google (cliente "Aplicacion web" de Google Cloud, ver docs/setup-google-cloud.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Claves de 32 bytes (base64url). Generar con: npm run gen:secrets -w worker
# Usa valores DISTINTOS a los de produccion.
TOKEN_ENC_KEY=
OAUTH_STATE_KEY=
# Web Push: JWK privado P-256 (la publica se deriva). Generar SIN mostrarlo en pantalla con:
#   npm run gen:vapid -w worker -- --dev-vars
# (VAPID_SUBJECT va en [vars] de wrangler.toml)
VAPID_PRIVATE_KEY=
# Solo desarrollo local (habilita CORS para http://localhost:5173)
ENV=dev
# Desarrollo local: callback y vuelta a la web servidas en localhost (sobrescriben [vars]).
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/google/callback
APP_URL=http://localhost:5173/organizador/
